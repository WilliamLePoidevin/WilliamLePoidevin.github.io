{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/community/**",
              "components/core/**",
              "components/fragrance/**",
              "components/shell/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Inter|Cormorant Garamond|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Inter, Cormorant Garamond, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|showValue|style|key|ref|className|style|children)$/]",
        "message": "<AccordBar> doesn't accept that prop. Declared props: label, value, tone, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:alloy|iris)$/]",
        "message": "<AccordBar> tone must be one of 'alloy' | 'iris'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|mode|nav|rail|sheet|toast|frame|style|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: children, mode, nav, rail, sheet, toast, frame, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:night|day)$/]",
        "message": "<AppShell> mode must be one of 'night' | 'day'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottlePortrait'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|ratio|radius|inset|glow|overlay|style|key|ref|className|style|children)$/]",
        "message": "<BottlePortrait> doesn't accept that prop. Declared props: src, name, ratio, radius, inset, glow, overlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottlePortrait'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:portrait|square|tall|hero)$/]",
        "message": "<BottlePortrait> ratio must be one of 'portrait' | 'square' | 'tall' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|mode|style|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: active, onChange, mode, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:discover|lineage|cabinet|trade|you)$/]",
        "message": "<BottomNav> active must be one of 'discover' | 'lineage' | 'cabinet' | 'trade' | 'you'."
