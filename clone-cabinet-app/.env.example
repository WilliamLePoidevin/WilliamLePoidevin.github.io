# v1.2 backend experiment — shared lineage-vote tallies via Supabase.
# Copy this file to .env.local and fill in your own project's values
# (Supabase dashboard -> Project Settings -> API). Never commit .env.local.
#
# Only the anon/public key goes here — it is designed to be public and is safe in frontend
# code because supabase/schema.sql locks the underlying table down; it never exposes the
# service_role key, which must never appear in frontend code at all.
#
# Leave both blank (or omit this file) to run without a backend — LineageVotesProvider then
# falls back to the original local-only voting behavior automatically.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
